# Radha Krishna Thakurwadi — production environment, filled in for
# https://radhakrishnathakurwadi.com/ on cPanel.
#
# Copy to `.env` on the host and fill in the four secrets marked FILL IN.
# **Never commit a populated .env.** Verify the result with:
#
#     php artisan deploy:check
#
# The step-by-step deployment is docs/DEPLOYMENT_CPANEL.md.

APP_NAME="Radha Krishna Thakurwadi"
APP_ENV=production
# FILL IN — generate once on the host: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.radhakrishnathakurwadi.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=hi
APP_FALLBACK_LOCALE=hi
APP_FAKER_LOCALE=hi_IN

# The site itself. Exact origins, never a wildcard: a wildcard cannot be
# combined with credentials and the browser refuses every request.
FRONTEND_URL=https://radhakrishnathakurwadi.com
CORS_ALLOWED_ORIGINS=https://radhakrishnathakurwadi.com,https://www.radhakrishnathakurwadi.com

# Hosts allowed to use the cookie session. Host names only — no scheme, no path.
SANCTUM_STATEFUL_DOMAINS=radhakrishnathakurwadi.com,www.radhakrishnathakurwadi.com

LOG_CHANNEL=stack
LOG_STACK=daily
# `error` in production: `debug` fills a shared host's disk in a week.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# cPanel prefixes both with the account name, e.g. thakur_site / thakur_app.
DB_DATABASE=
DB_USERNAME=
# FILL IN — from cPanel > MySQL Databases. Not the cPanel login.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# The leading dot matters: it is what lets the cookie set by the API be sent
# from the site, which is a different sub-domain of the same registrable domain.
SESSION_DOMAIN=.radhakrishnathakurwadi.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database

# `database` needs the cron worker from docs/DEPLOYMENT_CPANEL.md §7.
# Without that cron entry, use `sync` instead: sending inline is slower, but an
# announcement that fails then *says* it failed rather than being recorded as
# sent and silently never leaving.
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# cPanel > Email Accounts, then Connect Devices for the exact host and port.
MAIL_MAILER=smtp
MAIL_HOST=mail.radhakrishnathakurwadi.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@radhakrishnathakurwadi.com
# FILL IN — the mailbox password.
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@radhakrishnathakurwadi.com"
MAIL_FROM_NAME="${APP_NAME}"

# Development-only seed account. Both must stay empty in production; the
# deployment check fails if either is set.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# --- Media library -----------------------------------------------------------
MEDIA_DISK=public
MEDIA_PATH=media
# Keep this at or below cPanel's own upload_max_filesize and post_max_size, in
# the MultiPHP INI Editor. Those are a second, independent wall.
MEDIA_MAX_UPLOAD_KB=8192
MEDIA_QUALITY=82

# --- Devotee enquiries -------------------------------------------------------
ENQUIRY_REFERENCE_PREFIX=RKT/E
ENQUIRY_MIN_FILL_SECONDS=4
ENQUIRY_TOKEN_LIFETIME_MINUTES=120
ENQUIRY_CHALLENGE_THRESHOLD=2
ENQUIRY_CHALLENGE_WINDOW_MINUTES=60
ENQUIRY_DAILY_LIMIT_PER_IP=10
# Off until the committee asks for it: the address is typed by a stranger.
ENQUIRY_ACKNOWLEDGEMENT_ENABLED=false
ENQUIRY_ACK_COOLDOWN_MINUTES=60

# --- Announcements -----------------------------------------------------------
ANNOUNCEMENT_EMAIL_ENABLED=true
# Both stay false until a provider is chosen, approved *and wired up*.
ANNOUNCEMENT_SMS_ENABLED=false
ANNOUNCEMENT_WHATSAPP_ENABLED=false
ANNOUNCEMENT_MAX_SCHEDULE_DAYS=730

# --- Accounts ----------------------------------------------------------------
# Leave false while the temple has one treasurer, or the books deadlock on the
# first day and the committee shares a login instead.
ACCOUNTS_REQUIRE_SECOND_APPROVER=false
ACCOUNTS_MAX_RUPEES=10000000
ACCOUNTS_BACKDATE_LIMIT_DAYS=366
ACCOUNTS_PUBLIC_YEARS=5
# NEVER `public`. Bills carry a trader's name, telephone number and sometimes a
# signature; on the public disk they would be a permanent unauthenticated URL.
ACCOUNTS_ATTACHMENT_DISK=local
ACCOUNTS_ATTACHMENT_PATH=accounts/attachments
ACCOUNTS_ATTACHMENT_MAX_KB=8192
