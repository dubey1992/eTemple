# Radha Krishna Thakurbari — backend environment template.
# Copy to .env and fill in real values. NEVER commit a populated .env file.
# Generate APP_KEY with: php artisan key:generate

APP_NAME="Radha Krishna Thakurbari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=hi
APP_FALLBACK_LOCALE=hi
APP_FAKER_LOCALE=hi_IN

# Comma-separated origins allowed to call the API with credentials.
# In production this must be the exact Flutter Web origin, never "*".
FRONTEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Hosts permitted to use stateful (cookie/session) Sanctum authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:5000,127.0.0.1:5000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thakurbari
DB_USERNAME=thakurbari_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave blank for local development. In production set the parent domain, e.g. .thakurbari.in
SESSION_DOMAIN=
# Must be true in production (HTTPS only).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@thakurbari.local"
MAIL_FROM_NAME="${APP_NAME}"

# Development-only seed account. Leave unset in production; the dev seeder
# refuses to run when APP_ENV=production.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
