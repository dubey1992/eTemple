# Radha Krishna Thakurbari — backend environment template.
# Copy to .env and fill in real values. NEVER commit a populated .env file.
# Generate APP_KEY with: php artisan key:generate

APP_NAME="Radha Krishna Thakurbari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=hi
APP_FALLBACK_LOCALE=hi
APP_FAKER_LOCALE=hi_IN

# Comma-separated origins allowed to call the API with credentials.
# In production this must be the exact Flutter Web origin, never "*".
FRONTEND_URL=http://localhost:5000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Hosts permitted to use stateful (cookie/session) Sanctum authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:5000,127.0.0.1:5000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thakurbari
DB_USERNAME=thakurbari_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave blank for local development. In production set the parent domain, e.g. .thakurbari.in
SESSION_DOMAIN=
# Must be true in production (HTTPS only).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@thakurbari.local"
MAIL_FROM_NAME="${APP_NAME}"

# Development-only seed account. Leave unset in production; the dev seeder
# refuses to run when APP_ENV=production.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# --- Media library (Phase 5) -------------------------------------------------
# The disk uploaded photographs are written to. `public` is a symlinked
# storage/app/public and needs `php artisan storage:link` once per deployment;
# production may point this at `s3` without a code change.
MEDIA_DISK=public
MEDIA_PATH=media
# Largest accepted upload, in kilobytes. PHP's own upload_max_filesize and
# post_max_size are a second, independent wall — raise both together.
MEDIA_MAX_UPLOAD_KB=8192
# JPEG/WebP re-encode quality. Every upload is re-encoded, which is what strips
# location and camera data out of it.
MEDIA_QUALITY=82

# --- Devotee enquiries (Phase 7) ---------------------------------------------
# The public contact form is the only place an anonymous visitor writes to this
# database. Every number here decides how much abuse it absorbs, so a committee
# under a spam wave can tighten them without waiting for a release.
ENQUIRY_REFERENCE_PREFIX=RKT/E
# Floor and ceiling on the form ticket: faster than this is not a person, older
# than this is a harvested token being spent later.
ENQUIRY_MIN_FILL_SECONDS=4
ENQUIRY_TOKEN_LIFETIME_MINUTES=120
# Submissions from one address before the form starts asking a small arithmetic
# question, and the window that count is kept over.
ENQUIRY_CHALLENGE_THRESHOLD=2
ENQUIRY_CHALLENGE_WINDOW_MINUTES=60
# Hard daily ceiling per address, above the per-minute rate limit.
ENQUIRY_DAILY_LIMIT_PER_IP=10
# The acknowledgement e-mail. Off by default: an anonymous form with an e-mail
# field is an open relay for harassment unless it is rate limited per address
# and carries none of the sender's own words, which it does when enabled.
ENQUIRY_ACKNOWLEDGEMENT_ENABLED=false
ENQUIRY_ACK_COOLDOWN_MINUTES=60
