# Apache rules for the public site — copied into build/web by `flutter build web`.
#
# This file belongs in the document root that serves the Flutter bundle
# (`public_html` on cPanel). The API is a separate document root on
# api.radhakrishnathakurwadi.com and keeps Laravel's own public/.htaccess.
#
# See docs/DEPLOYMENT_CPANEL.md.

# --- HTTPS -------------------------------------------------------------------
# cPanel's AutoSSL issues the certificate; this is what stops a plain-HTTP visit
# from staying plain. Comment it out only while a certificate is still pending.
#
# This MUST come before the single-page rewrite below. That block ends every
# request with [L] — an existing file matches `^ - [L]`, everything else matches
# `^ index.html [L]` — so any rule placed after it is unreachable. Ordered the
# other way round, this redirect silently never fires and the whole site answers
# on plain HTTP, which is exactly how it shipped until 2026-09-06.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Send every unknown path to the app -------------------------------------
# The site is a single page: /gallery, /events/12 and /admin/donations are all
# routes inside one bundle, not files. Without this, a visitor who reloads on
# /gallery — or opens a link somebody sent them — gets the host's 404 page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # An existing file or directory is served as itself. This is what makes the
  # pre-rendered per-page metadata work: tool/generate_static_meta.dart writes a
  # real <slug>/index.html for each published page, and a crawler that does not
  # run JavaScript must be given *that* rather than the generic shell.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Headers -----------------------------------------------------------------
# The API sets its own (App\Http\Middleware\SecurityHeaders). These are for the
# static bundle, which never reaches PHP.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Not DENY: the site embeds nothing and is embedded by nobody, and a temple
  # site inside somebody else's frame is how a fake donation page is built.
  Header always set X-Frame-Options "SAMEORIGIN"

  # The redirect above moves a visitor to HTTPS once; this stops the plain-HTTP
  # request being made again at all, so there is no first request left to
  # intercept. Matches the API's own max-age. Only meaningful over HTTPS — a
  # browser ignores it on a plain-HTTP response — hence env=HTTPS.
  #
  # includeSubDomains covers api.radhakrishnathakurwadi.com, which has the same
  # certificate and is already HTTPS-only. Deliberately not `preload`: that is
  # published in the browsers themselves and is slow and awkward to undo.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Long caching for the files whose names really do change between releases:
  # everything under assets/ and the canvaskit build, which live at hashed
  # paths.
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|woff2|json|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The entry points keep the SAME names in every release, so none of them may
  # be cached that way. This block must come after the one above: Apache merges
  # <FilesMatch> sections in the order they appear, and the last `Header set`
  # for a header is the one that survives. (A plain `Header set ... env=` will
  # NOT do — every section is merged after the directives outside them, so the
  # rule above would win no matter where it was written.)
  #
  # This was wrong until 2026-09-07. `main.dart.js` is the whole application and
  # its name never changes; served `immutable` for a year, a returning visitor's
  # browser would not so much as revalidate it, and every deployment was
  # invisible to everyone who had been to the site before. `immutable` is a
  # promise that the file at this URL will never change, and for these six it is
  # simply false.
  #
  # `no-cache` does not mean "do not store": the browser keeps its copy and
  # revalidates, so an unchanged 4 MB bundle costs a 304, not a download.
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|main\.dart\.js|flutter_service_worker\.js|version\.json|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression -------------------------------------------------------------
# The Flutter bundle is the largest thing a village connection has to download.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml application/wasm
</IfModule>

<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

# Directory listings, never.
Options -Indexes
